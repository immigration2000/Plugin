# Check out sources with Windows line endings
*.h     text eol=crlf
*.cpp   text eol=crlf
*.cs    text eol=crlf
*.uplugin text eol=crlf
*.md    text
*.sh    text eol=lf
*.bat   text eol=crlf
# Test inputs/golden outputs are kept byte-for-byte (line ending conversion breaks the golden comparison)
Tests/inputs/**   -text
Tests/expected/** -text
Samples/**        -text
