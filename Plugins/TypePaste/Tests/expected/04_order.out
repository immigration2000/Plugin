// 이 파일은 TypePaste 플러그인으로 생성되었습니다.

#pragma once

#include "CoreMinimal.h"
#include "InventoryTypes.generated.h"

UENUM(BlueprintType)
enum class EItemCategory : uint8
{
	Weapon,
	Armor,
	Consumable,
};

USTRUCT(BlueprintType)
struct MYGAME_API FItemInfo
{
	GENERATED_BODY()

	UPROPERTY(EditAnywhere, BlueprintReadWrite)
	FName Id;

	UPROPERTY(EditAnywhere, BlueprintReadWrite)
	EItemCategory Category = EItemCategory::Weapon;
};

USTRUCT(BlueprintType)
struct MYGAME_API FInventorySlot
{
	GENERATED_BODY()

	UPROPERTY(EditAnywhere, BlueprintReadWrite)
	FItemInfo Item;

	UPROPERTY(EditAnywhere, BlueprintReadWrite)
	int32 Quantity = 1;
};

USTRUCT(BlueprintType)
struct MYGAME_API FInventory
{
	GENERATED_BODY()

	UPROPERTY(EditAnywhere, BlueprintReadWrite)
	TArray<FInventorySlot> Slots;

	UPROPERTY(EditAnywhere, BlueprintReadWrite)
	FItemInfo Selected;
};

