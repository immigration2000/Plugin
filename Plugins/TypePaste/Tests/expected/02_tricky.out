  EWeaponType : keep=EWeaponType ES=E_WeaponType EF=E_WeaponType none=WeaponType
  FWeaponData : keep=FWeaponData ES=S_WeaponData EF=F_WeaponData none=WeaponData
  WeaponType : keep=WeaponType ES=S_WeaponType EF=F_WeaponType none=WeaponType
  Foo : keep=Foo ES=S_Foo EF=F_Foo none=Foo
