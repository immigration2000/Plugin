#include "Chaos/ChaosEngineInterface.h"
#include "PlainDataTypes.generated.h"

class UTexture2D;
class UMaterialInterface;

/** Plain types without macros */
UENUM(BlueprintType)
enum class EDamageKind : uint8
{
	Physical,
	Fire = 5,
	Ice = Fire + 1,
};

UENUM(BlueprintType)
enum class ELegacyMode : uint8
{
	LM_A,
	LM_B,
};

USTRUCT(BlueprintType)
struct MYGAME_API FPlainData
{
	GENERATED_BODY()

	UPROPERTY(EditAnywhere, BlueprintReadWrite, Category = "PlainData")
	int32 Count = 0;

	UPROPERTY(EditAnywhere, BlueprintReadWrite, Category = "PlainData")
	float X = 0.f;

	UPROPERTY(EditAnywhere, BlueprintReadWrite, Category = "PlainData")
	float Y = 0.f;

	UPROPERTY(EditAnywhere, BlueprintReadWrite, Category = "PlainData")
	float Z = 0.f;

	UPROPERTY(EditAnywhere, BlueprintReadWrite, Category = "PlainData")
	uint8 bFlag : 1;

	UPROPERTY(EditAnywhere, Category = "PlainData")
	uint16 SmallNumber = 0;

	UPROPERTY(EditAnywhere, BlueprintReadWrite, Category = "PlainData")
	TObjectPtr<UTexture2D> RawIcon = nullptr;

	UPROPERTY(EditAnywhere, BlueprintReadWrite, Category = "PlainData")
	FString Label{ TEXT("Default") };

	UPROPERTY(EditAnywhere, Category = "PlainData")
	int32 Grid[4];

	static constexpr int32 MaxCount = 10;

	UPROPERTY(EditAnywhere, BlueprintReadWrite, Category = "PlainData")
	EDamageKind Kind = EDamageKind::Physical;

	TArray<TArray<int32>> Nested;

	UPROPERTY(EditAnywhere, BlueprintReadWrite, Category = "PlainData")
	FMyEngineThing Thing;

	UPROPERTY(EditAnywhere, BlueprintReadWrite, Category = "PlainData")
	FUnknownThing Unknown;

	UPROPERTY(EditAnywhere, BlueprintReadWrite, Category = "PlainData")
	EPhysicalSurface Surface;

	UPROPERTY(EditAnywhere, BlueprintReadWrite, Category = "PlainData")
	TObjectPtr<const UMaterialInterface> Material = nullptr;

	FPlainData()
		: Count(0), X(1.f)
	{
		// ctor body
		Kind = EDamageKind::Fire;
	}

	FPlainData(int32 InCount) : Count(InCount), Label{ TEXT("x") } {}

	float GetTotal() const { return X + Y + Z; }

	void Reset();

	bool operator==(const FPlainData& Other) const
	{
		return Count == Other.Count;
	}
};

