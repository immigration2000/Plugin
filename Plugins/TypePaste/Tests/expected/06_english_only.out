==================== DEFAULT VALUES ====================
  10.f -> 10.0
  -.5f -> -0.5
  3. -> 3.0
  1.5e-3f -> 1.5e-3
  100 -> 100
  UE_PI -> (skip)
  0x1F -> 31
  -42 -> -42
  1'000'000 -> 1000000
  5000000000LL -> 5000000000
  300 -> (skip)
  255u -> 255
  true -> true
  1 -> true
  TEXT("Hello \"World\"") -> Hello "World"
  NAME_None -> (skip)
  FName(TEXT("Socket_R")) -> Socket_R
  NSLOCTEXT("Ns", "Key", "검") -> 검
  FText::GetEmpty() -> (skip)
  TEXT("") -> (skip)

